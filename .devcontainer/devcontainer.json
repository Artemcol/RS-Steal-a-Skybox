{
    "name": "Tiny10 on KVM (Codespaces)",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "forwardPorts": [8006],
    "portsAttributes": {
        "8006": {
            "label": "Tiny10 Desktop",
            "onAutoForward": "openBrowser"
        }
    },
    "onCreateCommand": "sudo apt-get update && sudo apt-get install -y qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils cpu-checker && sudo kvm-ok",

    "shutdownAction": "stopContainer",
    "containerEnv": {
        "WIN_VERSION": "tiny10",
        "WIN_RESOLUTION": "1366x768"
    }
}
